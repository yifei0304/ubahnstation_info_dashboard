          <call id="a32" endpoint="mvg_departures">
            <parameters>
              <label>Get Departure</label>
              <color/>
              <method>:get</method>
              <arguments>
                <globalId>!data.station</globalId>
                <limit>50</limit>
                <offsetInMinutes>0</offsetInMinutes>
                <transportTypes>UBAHN,BUS,REGIONAL_BUS</transportTypes>
              </arguments>
            </parameters>
            <code>
              <signal>false</signal>
              <prepare/>
              <finalize output="result">deps = result

now = Time.now.to_i * 1000
data.ubahn = deps.select{|d| 
  d['transportType'] == 'UBAHN' &amp;&amp; !d['cancelled'] &amp;&amp;
  (d['realtimeDepartureTime'] || d['plannedDepartureTime']) &gt; now - 30000
}.first(4)
data.bus = deps.select{|d|
  ['BUS','REGIONAL_BUS'].include?(d['transportType']) &amp;&amp; !d['cancelled'] &amp;&amp;
  (d['realtimeDepartureTime'] || d['plannedDepartureTime']) &gt; now - 30000
}.first(4)
data.messages = deps.flat_map{|d| d['messages'] || []}.uniq.first(3)</finalize>
